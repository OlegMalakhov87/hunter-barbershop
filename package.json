{
  "name": "hunter-barbershop",
  "version": "1.0.0",
  "private": true,
  "description": "Одностраничный сайт барбершопа Hunter",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "escape-html": "^1.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.37.5",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
