PORT=
HOST=127.0.0.1
NODE_ENV=development
SITE_URL=
# false для прямого запуска; loopback для прокси на этой же машине.
TRUST_PROXY=
DB_STORAGE=

# Данные для входа в /admin. Пароль от 12 символов, ключ от 32.
ADMIN_LOGIN=
ADMIN_PASSWORD=
JWT_SECRET=

# Скопируйте ссылку формата https://nНОМЕР.yclients.ru/ из личного кабинета.
# Такая ссылка включает официальный выезжающий виджет на компьютере.
# Пока поле пустое, /booking возвращает посетителя к блоку записи на сайте.
YCLIENTS_BOOKING_URL=

# Необязательные метки для ссылок на способы связи.
UTM_SOURCE=
UTM_MEDIUM=
UTM_CAMPAIGN=

# Необязательный счётчик Яндекс.Метрики.
YANDEX_METRIKA_ID=
